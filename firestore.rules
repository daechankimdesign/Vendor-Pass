rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPM() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'property_manager';
    }

    function hasPmRelationship(vendorUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(vendorUid)/pmRelationships/$(request.auth.uid));
    }

    // ── leads ─────────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['email', 'role', 'displayName', 'createdAt']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.role in ['property_manager', 'vendor'] &&
        request.resource.data.createdAt == request.time;
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── vendors (public discoverable fields) ──────────────────────────────────
    // Split-collection: vendors/{vendorUid} holds public-safe fields only.
    // PII (contactEmail, phone) lives in vendors/{vendorUid}/private/contact.
    match /vendors/{vendorUid} {
      allow create: if isOwner(vendorUid) &&
        request.resource.data.keys().hasOnly([
          'businessName',
          'businessZipCode',
          'serviceZipCodes',
          'categories',
          'discoverable',
          'createdAt'
        ]) &&
        request.resource.data.createdAt == request.time;
      allow update: if isOwner(vendorUid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'businessName',
          'businessZipCode',
          'serviceZipCodes',
          'categories',
          'discoverable'
        ]);
      allow read: if isOwner(vendorUid);
      allow read: if isAdmin();
      allow read: if hasPmRelationship(vendorUid);
      // Public-safe vendor search is intentionally open for discoverable vendors.
      allow read: if resource.data.discoverable == true;
    }

    // Private contact info — only vendor self, admin, or PM with relationship
    match /vendors/{vendorUid}/private/{doc} {
      allow create: if isOwner(vendorUid) &&
        doc == 'contact' &&
        request.resource.data.keys().hasOnly(['contactEmail', 'phone']) &&
        request.resource.data.contactEmail == request.auth.token.email;
      allow update: if isOwner(vendorUid) &&
        doc == 'contact' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone']);
      allow read: if isOwner(vendorUid);
      allow read: if isAdmin();
      allow read: if hasPmRelationship(vendorUid);
    }

    // Documents subcollection
    match /vendors/{vendorUid}/documents/{docType} {
      allow read: if isOwner(vendorUid) || isAdmin() || hasPmRelationship(vendorUid);
      // Writes that affect verification state go through Cloud Functions.
      allow create, update, delete: if false;
    }

    // PM relationships subcollection
    match /vendors/{vendorUid}/pmRelationships/{pmUid} {
      allow read: if isOwner(pmUid) || isOwner(vendorUid);
      allow update: if isOwner(pmUid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workOrdersPaused']);
      allow read: if isAdmin();
    }

    // ── projects ──────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read, update, delete: if isSignedIn() && resource.data.pmUid == request.auth.uid;
      allow create: if isPM() && request.resource.data.pmUid == request.auth.uid;
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)/vendors/$(request.auth.uid));
      allow read: if isAdmin();
    }

    match /projects/{projectId}/vendors/{vendorUid} {
      allow read, write: if isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.pmUid == request.auth.uid;
      allow read: if isOwner(vendorUid);
      allow read: if isAdmin();
    }

    // ── invites ────────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      // Invite writes go through Cloud Functions so project attachment and
      // PM relationship creation remain atomic and server-validated.
      allow create, update, delete: if false;
      allow read: if isSignedIn() && resource.data.pmUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.vendorUid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.vendorEmail == request.auth.token.email;
      allow read, write: if isAdmin();
    }

    // ── notifications ──────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() &&
        (resource.data.vendorUid == request.auth.uid || resource.data.pmUid == request.auth.uid);
      // Cloud Functions write via admin SDK
    }
  }
}
