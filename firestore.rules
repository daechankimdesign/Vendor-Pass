rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPM() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'property_manager';
    }

    function hasPmRelationship(vendorUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(vendorUid)/pmRelationships/$(request.auth.uid));
    }

    // ── leads ─────────────────────────────────────────────────────────────────
    // Create-only by anyone (waitlist), no read
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isAdmin();
    }

    // ── vendors (public discoverable fields) ──────────────────────────────────
    // Split-collection: vendors/{vendorUid} holds public-safe fields only
    // (businessName, businessZipCode, serviceZipCodes, categories, discoverable, createdAt)
    // PII (contactEmail, phone) lives in vendors/{vendorUid}/private/contact
    match /vendors/{vendorUid} {
      // Vendor can read/write their own doc
      allow read, write: if isOwner(vendorUid);
      // Admin can read all
      allow read: if isAdmin();
      // Any PM with a relationship can read
      allow read: if hasPmRelationship(vendorUid);
      // Any signed-in PM can read discoverable vendors (enables search)
      allow read: if isPM() && resource.data.discoverable == true;
    }

    // Private contact info — only vendor self, admin, or PM with relationship
    match /vendors/{vendorUid}/private/{doc} {
      allow read, write: if isOwner(vendorUid);
      allow read: if isAdmin();
      allow read: if hasPmRelationship(vendorUid);
    }

    // Documents subcollection
    match /vendors/{vendorUid}/documents/{docType} {
      allow read: if isOwner(vendorUid) || isAdmin() || hasPmRelationship(vendorUid);
      // Vendor can write most fields; tier and adminReviewed are admin-only
      allow create: if isOwner(vendorUid);
      allow update: if isOwner(vendorUid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'adminReviewed']);
      allow update: if isAdmin();
    }

    // PM relationships subcollection
    match /vendors/{vendorUid}/pmRelationships/{pmUid} {
      allow read, write: if isOwner(pmUid) || isOwner(vendorUid);
      allow read: if isAdmin();
    }

    // ── projects ──────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      // PM owner has full access
      allow read, write: if isSignedIn() && resource.data.pmUid == request.auth.uid;
      allow create: if isPM();
      // Vendors attached to the project can read project details
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)/vendors/$(request.auth.uid));
      allow read: if isAdmin();
    }

    match /projects/{projectId}/vendors/{vendorUid} {
      allow read, write: if isSignedIn() &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.pmUid == request.auth.uid;
      allow read: if isOwner(vendorUid);
      allow read: if isAdmin();
    }

    // ── invites ────────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      // PM can create and read their own invites
      allow create: if isPM();
      allow read, update: if isSignedIn() && resource.data.pmUid == request.auth.uid;
      // Vendor (by uid) can read and update status
      allow read, update: if isSignedIn() && resource.data.vendorUid == request.auth.uid;
      // Pending-signup: any signed-in user whose email matches vendorEmail can read
      allow read: if isSignedIn() && resource.data.vendorEmail == request.auth.token.email;
      allow read, write: if isAdmin();
    }

    // ── notifications ──────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() &&
        (resource.data.vendorUid == request.auth.uid || resource.data.pmUid == request.auth.uid);
      allow write: if isAdmin();
      // Cloud Functions write via admin SDK — covered by admin SDK bypass
    }
  }
}
